{
  "dependencies": {
    "hono": "^4.6.14",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.23.8"
  },
  "description": "THE BD TODAY \u2014 a professional Bengali/English news publishing platform with a full CMS and admin dashboard, deployed on Cloudflare Workers + D1 + R2.",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wrangler": "^3.91.0"
  },
  "engines": {
    "node": ">=20"
  },
  "name": "the-bd-today",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "db:migrate:local": "wrangler d1 migrations apply the-bd-today-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply the-bd-today-db --remote",
    "db:seed": "echo 'Seed data is in migrations/0002_seed.sql and is applied by: npm run db:migrate:local / npm run db:migrate:remote'",
    "deploy": "npm run build && wrangler deploy",
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "preview": "vite preview",
    "test": "vitest run tests/",
    "test:watch": "vitest tests/",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.1.0"
}
